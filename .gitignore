# Local Environment Credentials
# `.env` alone matches only that exact name. Variants such as .env.local,
# .env.aura.bak and .env.production are the same secrets under another
# filename, and this repository is public, so they are matched explicitly.
.env
.env.*
!.env.example

# Python Virtual Environment
venv/
.venv/
env/

# Python Cache & Compiled Files
__pycache__/
*.py[cod]
*$py.class

# Application Caches & Temporary Files
schema_cache.json
temp_uploads/
report.md

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
